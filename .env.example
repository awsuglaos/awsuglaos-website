# Copy to .env for local development. Never commit .env.
# On AWS these are supplied by SST resource linking, not by this file.

# --- Local Postgres (docker-compose.yml) ---
DATABASE_URL=postgresql://awsug:awsug_local_dev@localhost:5433/awsug_lao

# --- Local auth shim ---
# Bypasses Cognito so the backoffice is usable before the AWS account exists.
# MUST be false/unset anywhere that is not a developer machine.
DEV_AUTH=true

# --- Public URLs ---
PUBLIC_SITE_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3000

# --- Email ---
# Resend takes precedence over SES. Set both and Resend wins; clear
# RESEND_API_KEY to hand sending back to SES with no code change.
# The awsug.la domain must be verified in Resend before noreply@ can send.
RESEND_API_KEY=
MAIL_FROM_NAME=AWS User Group Laos
MAIL_FROM_EMAIL=noreply@awsug.la

# Used only when RESEND_API_KEY is unset. Must be a verified SES identity;
# see DEPLOYMENT.md "Phase 5 — Email". Leave blank and mail prints to the
# console, which is the normal local-development setup.
SES_FROM_ADDRESS=
SES_CONFIGURATION_SET=

# --- AWS (leave blank until the account exists; see M7 in the plan) ---
AWS_REGION=ap-southeast-1
# Set only when running drizzle-kit against Aurora via the Data API:
# DB_CLUSTER_ARN=
# DB_SECRET_ARN=
# DB_NAME=awsug_lao
