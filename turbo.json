{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "DEV_AUTH",
    "AWS_REGION",
    "AWS_PROFILE",
    "DB_CLUSTER_ARN",
    "DB_SECRET_ARN",
    "DB_NAME",
    "PUBLIC_SITE_URL",
    "PUBLIC_API_URL",
    "COGNITO_USER_POOL_ID",
    "COGNITO_CLIENT_ID",
    "COGNITO_DOMAIN_URL",
    "SES_FROM_ADDRESS",
    "SES_CONFIGURATION_SET",
    "RESEND_API_KEY",
    "MAIL_FROM_NAME",
    "MAIL_FROM_EMAIL",
    "UPLOADS_BUCKET",
    "UPLOADS_PUBLIC_URL",
    "ALLOW_INDEXING"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".svelte-kit/**", "build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "check": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
